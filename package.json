{
  "name": "amaravati-observatory",
  "version": "0.2.0",
  "private": true,
  "description": "Evidence-first 3D observatory of Amaravati, the Andhra Pradesh capital under construction.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node server.mjs",
    "vendor": "node scripts/vendor.mjs",
