    "build": "python3 scripts/build_site.py",
    "check": "python3 scripts/build_site.py --check && node scripts/check-js.mjs"
  },
  "devDependencies": {
    "three": "0.184.0"
  },
  "engines": {
    "node": ">=18"
  }
}
